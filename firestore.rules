rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny by default — only grant what's needed
    match /{document=**} {
      allow read, write: if false;
    }

    // NAPs: auth users can read; write requires auth
    match /naps/{napId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Clientes: auth users can read/write
    match /clientes/{clienteId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null;
    }

    // Geographic config: auth users can read/write
    match /config_geografica/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Usuarios: auth users can read/write
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Logs: auth users can read/write
    match /audit_logs/{logId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;
    }

  }
}
